BACKEND_BASE_URL=http://<IP_GCP>:8080/api
BACKEND_WS_URL=ws://<IP_GCP>:8080/api/ws
HEARTBEAT_PATH=/robot/heartbeat
OBSERVATION_PATH=/robot/observations

CAMERA_TYPE=usb
CAMERA_FRONT_INDEX=0
CAMERA_LEFT_INDEX=1
CAMERA_RIGHT_INDEX=2
CAMERA_WIDTH=640
CAMERA_HEIGHT=480

MODEL_PATH=/app/models/modelo_vivero.tflite
LABELS_PATH=/app/models/labels.txt
AI_CONFIDENCE_THRESHOLD=0.65

ROBOT_ID=ROBOT-001
PATROL_SPEED=40
OBSTACLE_DISTANCE_CM=20
LINE_LOST_TIMEOUT=3.0
STATUS_INTERVAL_SECONDS=10
MANUAL_DEFAULT_SPEED=35
LINE_ACTIVE_LOW=true

STREAM_FPS=10
STREAM_QUALITY=60

LCD_ENABLED=true
LED_ENABLED=true
BUZZER_ENABLED=true
