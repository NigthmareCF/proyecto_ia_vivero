BACKEND_BASE_URL=http://192.168.1.27:3000/api
BACKEND_WS_URL=ws://192.168.1.27:3000/api/ws/robot-stream
HEARTBEAT_PATH=/robot/heartbeat
OBSERVATION_PATH=/robot/observations
COMMAND_NEXT_PATH=/robot/commands/next
COMMAND_ACK_PATH_TEMPLATE=/robot/commands/{commandId}/ack

CAMERA_TYPE=usb
CAMERA_FRONT_INDEX=4
CAMERA_LEFT_INDEX=0
CAMERA_RIGHT_INDEX=2
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
PLANT_ROI_ENABLED=true
PLANT_ROI_ORIENTATION=adaptive
PLANT_ROI_WIDTH_FACTOR=5.0
PLANT_ROI_HEIGHT_FACTOR=4.0
PLANT_ROI_VERTICAL_WIDTH_FACTOR=4.0
PLANT_ROI_VERTICAL_HEIGHT_FACTOR=6.0
PLANT_ROI_HORIZONTAL_WIDTH_FACTOR=5.0
PLANT_ROI_HORIZONTAL_HEIGHT_FACTOR=4.0
PLANT_ROI_Y_OFFSET_FACTOR=0.4
PLANT_ROI_LEFT_X_OFFSET_FACTOR=1.6
PLANT_ROI_RIGHT_X_OFFSET_FACTOR=-1.6
PLANT_ROI_FRONT_X_OFFSET_FACTOR=0.0
PLANT_ROI_MIN_WIDTH_PX=260
PLANT_ROI_MIN_HEIGHT_PX=260

MODEL_PATH=/app/models/modelo_vivero.tflite
LABELS_PATH=/app/models/labels.txt
AI_CONFIDENCE_THRESHOLD=0.65

ROBOT_ID=ROBOT-001
PATROL_SPEED=40
OBSTACLE_DISTANCE_CM=20
LINE_LOST_TIMEOUT=3.0
STATUS_INTERVAL_SECONDS=10
MANUAL_DEFAULT_SPEED=35
MANUAL_COMMAND_TIMEOUT_SECONDS=0.3
SPEED_PROFILE_LOW=30
SPEED_PROFILE_MEDIUM=45
SPEED_PROFILE_HIGH=65
SPEED_PROFILE_TURBO=85
LINE_ACTIVE_LOW=false
REAR_IR_ACTIVE_HIGH=false
HEARTBEAT_LED_BLINK_INTERVAL_SECONDS=0.5
HEARTBEAT_LED_FAST_BLINK_INTERVAL_SECONDS=0.2
HEARTBEAT_LED_BREATHE_STEP_SECONDS=0.04
HEARTBEAT_LED_BREATHE_STEP_DUTY=5

STREAM_FPS=10
STREAM_QUALITY=60
CAPTURE_COUNT=6
QR_CAPTURE_SPEED=25
BURST_FRAME_INTERVAL_SECONDS=0.08
END_ROW_FORWARD_SECONDS=5.0
END_ROW_TURN_SECONDS=1.0
COMMAND_POLL_INTERVAL_SECONDS=1.0
OBSERVATION_FLUSH_INTERVAL_SECONDS=5.0
QR_DETECTION_COOLDOWN_SECONDS=12.0
LOCAL_AI_ENABLED=false
OFFLINE_QUEUE_DIR=/app/data/offline-queue

LCD_ENABLED=true
LED_ENABLED=true
BUZZER_ENABLED=true
