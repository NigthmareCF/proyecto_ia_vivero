# Perfil y servidor
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Base de datos
DB_HOST=db
DB_PORT=5432
DB_NAME=vivero_db
DB_USERNAME=vivero_user
DB_PASSWORD=vivero_pass

# Seguridad
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
FRONTEND_PORT=3000

# Almacenamiento
IMAGES_PATH=/app/images
PUBLIC_BASE_URL=http://localhost:3000

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@vivero.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_ENVELOPE_FROM=noreply@vivero.com
MAIL_SMTP_LOCALHOST=
MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_SMTP_TIMEOUT_MS=15000
MAIL_SMTP_WRITE_TIMEOUT_MS=15000

# Vision API externa
VISION_API_ENABLED=false
VISION_API_PROVIDER=gemini
VISION_API_MODEL=gemini-2.5-flash
VISION_API_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# Para activar Gemini en este equipo, usa:
# VISION_API_ENABLED=true
# VISION_API_PROVIDER=gemini
# GEMINI_API_KEY=<tu_clave_local>

# Frontend
VITE_API_URL=/api
VITE_WS_URL=/api/ws

