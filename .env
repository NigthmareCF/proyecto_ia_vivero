# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@vivero.com
MANAGEMENT_HEALTH_MAIL_ENABLED=false
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_ENABLE=false
MAIL_SMTP_ENVELOPE_FROM=noreply@vivero.com
MAIL_SMTP_LOCALHOST=
MAIL_SMTP_CONNECTION_TIMEOUT_MS=10000
MAIL_SMTP_TIMEOUT_MS=15000
MAIL_SMTP_WRITE_TIMEOUT_MS=15000

# Gemini API para reporte final consolidado.
VISION_API_ENABLED=true
VISION_API_PROVIDER=gemini
VISION_API_MODEL=gemini-2.5-flash
VISION_API_TIMEOUT_SECONDS=45
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models

# VLM local en la VM. Docker descargara la imagen y el modelo al levantar el stack en GCP.
VLM_IMAGE=vllm/vllm-openai:latest
VLM_QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct-AWQ
VLM_SERVED_MODEL_NAME=qwen-vl-local
VLM_QUANTIZATION=awq
VLM_MAX_MODEL_LEN=8192
HUGGING_FACE_HUB_TOKEN=
VISION_LOCAL_VLM_ENABLED=true
VISION_LOCAL_VLM_URL=http://vlm-qwen:8000/v1
VISION_LOCAL_VLM_MODEL=qwen-vl-local
VISION_LOCAL_VLM_TIMEOUT_SECONDS=120
VISION_PATROL_CLASSIFIER_ENABLED=true
VISION_PATROL_GEMINI_REPORT_ENABLED=true

# Frontend
VITE_API_URL=/api
VITE_WS_URL=/api/ws
